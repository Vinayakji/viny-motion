# Genymotion Pipeline - .gitignore

# Reports and findings (per-run, sensitive)
reports/
findings/
run_*/

# Runtime artifacts
*.tmp
*.log
*.pid
/tmp/

# Credentials and secrets
config/target.yaml
*.key
*.pem
*.p12
*.jks
.env
.env.local

# Node
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# APK files (large)
*.apk
*.aab

# Genymotion snapshots
*.vbox
*.vbox-snapshot

# Frida
*.frida
