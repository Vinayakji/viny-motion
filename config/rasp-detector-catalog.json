        "category": "app_integrity",
        "owasp": "M1",
        "cwe": "CWE-353",
        "severity": "INFO",
        "description": "Verifies APK signature, installation source, and code integrity",
        "detection_methods": [
          { "type": "static", "pattern": "PackageManager.getPackageInfo.*GET_SIGNATURES|PackageManager.GET_SIGNING_CERTIFICATES" },
          { "type": "static", "pattern": "signature.*check|integrity.*check|hash.*check|tamper" },
          { "type": "dynamic", "method": "signature_verification" },
          { "type": "dynamic", "method": "hash_verification" }
        ],
        "bypass_vectors": ["Re-sign APK with debug key", "Hook PackageManager", "Modify signature check logic"],
        "frida_scripts": ["test-universal-script.js"]
      },
