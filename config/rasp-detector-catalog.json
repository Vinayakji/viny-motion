{
  "detector_catalog": {
    "version": "1.0.0",
    "description": "Runtime Application Self-Protection (RASP) detector catalog for Android apps",
    "last_updated": "2026-09-01",
    "detectors": [
      {
        "id": "RASP-001",
        "name": "Root Detection",
        "category": "device_integrity",
        "owasp": "M1",
        "cwe": "CWE-284",
        "severity": "INFO",
        "description": "Checks if device is rooted via su binary, SuperSU, Magisk, KernelSU",
        "detection_methods": [
          { "type": "static", "pattern": "isRooted|isDeviceRooted|checkRoot|RootBeer|/system/app/Superuser|/system/bin/su|/system/xbin/su" },
          { "type": "static", "pattern": "com.noshufou.android.su|com.thirdparty.superuser|eu.chainfire.supersu|com.koushikdutta.superuser" },
          { "type": "dynamic", "method": "frida_root_detection" },
          { "type": "dynamic", "method": "objection_root_detection" }
        ],
        "bypass_vectors": ["Frida root bypass", "Hide My Magisk", "Zygisk", "KernelSU denylist"],
        "frida_scripts": ["root-bypass.js", "rootkit-detector.js"]
      },
      {
        "id": "RASP-002",
        "name": "Emulator Detection",
        "category": "device_integrity",
        "owasp": "M1",
        "cwe": "CWE-284",
        "severity": "INFO",
        "description": "Detects Android emulators (AVD, Genymotion, BlueStacks, LDPlayer)",
        "detection_methods": [
          { "type": "static", "pattern": "goldfish|generic|sdk_gphone|emulator|Genymotion|/dev/socket/qemud|/dev/qemu_pipe|10.0.2.15" },
          { "type": "static", "pattern": "build.goldfish|android.product.model|X86|generic_x86|ro.hardware|ro.product.model" },
          { "type": "dynamic", "method": "build_properties_spoof" },
          { "type": "dynamic", "method": "sensor_check" }
        ],
        "bypass_vectors": ["Build property spoofing", "Sensor emulation", "Frida property hooks"],
        "frida_scripts": ["emulator-detection-bypass.js"]
      },
      {
        "id": "RASP-003",
        "name": "Anti-Debug Detection",
        "category": "anti_analysis",
        "owasp": "M1",
        "cwe": "CWE-388",
        "severity": "INFO",
        "description": "Detects debugger attachment via TracerPid, timing checks, Debug API",
        "detection_methods": [
          { "type": "static", "pattern": "isDebuggerConnected|Debug.isDebugger|ptrace|TracerPid|PTRACE_TRACEME" },
          { "type": "static", "pattern": "/proc/self/status|timing.*check|System.nanoTime|Debug.waitForDebugger" },
          { "type": "dynamic", "method": "timing_check" },
          { "type": "dynamic", "method": "tracerpid_check" }
        ],
        "bypass_vectors": ["Frida anti-debug bypass", "TracerPid patching", "Timing normalization"],
        "frida_scripts": ["anti-debug.js"]
      },
      {
        "id": "RASP-004",
        "name": "Frida Detection",
        "category": "anti_analysis",
        "owasp": "M1",
        "cwe": "CWE-388",
        "severity": "INFO",
        "description": "Detects Frida framework via port scanning, memory patterns, named pipes",
        "detection_methods": [
          { "type": "static", "pattern": "frida|gadget|REJECT|LIBFRIDA" },
          { "type": "dynamic", "method": "port_scan_27042" },
          { "type": "dynamic", "method": "memory_pattern_scan" },
          { "type": "dynamic", "method": "named_pipe_check" }
        ],
        "bypass_vectors": ["Frida server renaming", "Custom Frida builds", "frida-server on non-standard port"],
        "frida_scripts": ["android-anti-frida-countermeasures.js"]
      },
      {
